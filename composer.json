{
  "name": "student/sim-inventory",
  "description": "Sistem Informasi Manajemen Inventori Barang berbasis PHP native",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "dompdf/dompdf": "^3.1",
    "phpoffice/phpspreadsheet": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.0",
      "php-64bit": "8.2.0"
    }
  }
}
