          "raw": "{\n  \"kode_barang\": \"{{kode_barang}}\",\n  \"nama_barang\": \"Barang Demo Diubah\",\n  \"kategori\": \"Elektronik\",\n  \"satuan\": \"buah\",\n  \"stok_minimum\": 5,\n  \"gudang_id\": 1,\n  \"deskripsi\": \"Data sementara untuk demonstrasi API\"\n}",
          "options": {
            "raw": {
              "language": "json"
