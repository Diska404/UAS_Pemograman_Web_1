{
  "info": {
    "name": "SIM Inventory API v1",
    "description": "Jalankan berurutan di environment lokal. Cookie jar harus aktif. Membuat dan menghapus hanya barang demo baru. Lihat docs/API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - CSRF dan cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/csrf",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "csrf"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"csrf_token\", pm.response.json().data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login / token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token dibuat\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET barang",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/barang",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "barang"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET berhasil\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - POST barang demo baru",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/barang",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "barang"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kode_barang\": \"API-{{$timestamp}}\",\n  \"nama_barang\": \"Barang Demo Postman\",\n  \"kategori\": \"Elektronik\",\n  \"satuan\": \"buah\",\n  \"stok_minimum\": 5,\n  \"gudang_id\": 1,\n  \"deskripsi\": \"Data sementara untuk demonstrasi API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Barang dibuat\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.environment.set(\"barang_id\", pm.response.json().data.id); pm.environment.set(\"kode_barang\", pm.response.json().data.kode_barang); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - GET detail barang demo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/barang/{{barang_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "barang",
            "{{barang_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Detail tersedia\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
