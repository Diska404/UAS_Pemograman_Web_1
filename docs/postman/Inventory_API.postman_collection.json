      ]
    },
    {
      "name": "11 - Token dicabut ditolak",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/barang",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "barang"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
